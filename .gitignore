# Whitelist: only the code and data the Etch app runs on. Everything else in this folder
# (demos, build outputs, archives, caches, QA runs, vendored third-party clones) stays local.
/*
!/.gitignore
!/README.md
!/setup.sh
!/run.sh

!/agent/
/agent/_rend_tmp.py

!/engine/
/engine/*
!/engine/README.md
!/engine/etch.py
!/engine/pyproject.toml
!/engine/uv.lock
!/engine/etchlib/
!/engine/kicad_side/
!/engine/specs/
!/engine/tests/
!/engine/parts/
/engine/parts/*
!/engine/parts/build_index.py
!/engine/parts/index.json
!/engine/parts/agent_index.json
!/engine/parts/kicad_catalog.json
!/engine/parts/footprint_library.json
!/engine/parts/classifier.json
!/engine/parts/classifier.npz
!/engine/parts/piece_renders/
!/engine/parts/cache/
/engine/parts/piece_renders/*.kicad_prl

!/studio/
/studio/*
!/studio/kicad_frames.py
!/studio/stt/

!/deploy/
/deploy/*
!/deploy/etch_public.py
!/deploy/redeploy.sh
!/deploy/restart.sh
!/deploy/tunnel.sh
!/deploy/stt.sh
!/deploy/etch-app/

# Espressif KiCad library 3.2.1, sparse (see its PROVENANCE.md)
!/vendor/
/vendor/*
!/vendor/espressif-kicad-libraries/

__pycache__/
.pytest_cache/
.ruff_cache/
.venv/
.vercel/
.DS_Store
