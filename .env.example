# Etch settings. setup.sh copies this file to .env (git-ignored, never committed). Fill in what you need.
# Real environment variables always win over .env. On macOS each key can also live in the Keychain instead
# (service name in brackets), so the file can stay free of secrets.
# Blank values are ignored.

# ---------------------------------------------------------------- model endpoint (REQUIRED: pick one)
# Etch's agents talk to any OpenAI-compatible chat endpoint that supports tool calls.
#
# A) Crusoe Managed Inference with NVIDIA Nemotron (the default, what etch.chat runs on).
#    Key: Crusoe Cloud console (https://console.crusoecloud.com) -> Managed Inference -> API keys.
CRUSOE_API_KEY=
#    [Keychain: crusoe-api-key]
#
# B) Any other OpenAI-compatible endpoint: set the URL, the key and the two models.
#    OpenAI:   ETCH_BASE_URL=https://api.openai.com/v1   ETCH_MODEL=gpt-5-mini  ETCH_SUB_MODEL=gpt-5-nano
#    Ollama:   ETCH_BASE_URL=http://127.0.0.1:11434/v1   ETCH_MODEL=qwen3:32b   ETCH_SUB_MODEL=qwen3:8b
#    vLLM:     ETCH_BASE_URL=http://127.0.0.1:8000/v1    ETCH_MODEL=<served model name>
#    A server on localhost needs no key. Small local models build simpler boards and fail more repairs.
ETCH_BASE_URL=
ETCH_API_KEY=
ETCH_MODEL=
ETCH_SUB_MODEL=
# Off Crusoe, the client-side pace limit can go up (requests per minute across all agents, default 28).
ETCH_RATE_PER_MIN=

# ---------------------------------------------------------------- OpenAI (optional, recommended)
# Used for: the fallback when the primary endpoint errors, Etch's spoken replies (TTS), the prompt rewriter
# and part decisions. Without it those features switch off and builds still run.
# Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
#    [Keychain: openai-api-key]
# "off" never falls back to OpenAI even when the key is set.
ETCH_FALLBACK=
# Fallback to some other OpenAI-compatible endpoint instead of OpenAI:
ETCH_FALLBACK_BASE_URL=
ETCH_FALLBACK_API_KEY=
ETCH_FALLBACK_MODEL=
ETCH_FALLBACK_SUB_MODEL=

# ---------------------------------------------------------------- You.com (optional)
# Web search for parts that are not in the KiCad libraries; the part scout then pulls the real part from
# LCSC/EasyEDA or GitHub. Without it the scout only searches the local libraries.
# Key: https://you.com/platform (API keys)
YOU_API_KEY=
#    [Keychain: you-api-key]

# ---------------------------------------------------------------- server
# Backend port (the page calls http://127.0.0.1:3439 by default).
ETCH_PUBLIC_PORT=3439
# Local page and speech-to-text ports used by run.sh.
ETCH_PAGE_PORT=8766
ETCH_STT_PORT=3421
# 127.0.0.1 keeps the API on this machine (reach it from outside through scripts/tunnel.sh). 0.0.0.0 in Docker.
ETCH_BIND=
# Extra browser origins allowed to call your backend, as one regex. The default already allows
# https://etch.chat, https://www.etch.chat, https://etch*.vercel.app and http://localhost / 127.0.0.1.
ETCH_ORIGINS=
# Per-IP and daily build caps (defaults 10 per IP per hour, 80 per day). Raise them on your own machine.
ETCH_RUNS_PER_IP_HOUR=
ETCH_RUNS_PER_DAY=
# Builds running at once (default 12; each one is a Python + KiCad process, about 1 GB of RAM).
ETCH_MAX_RUNS=

# ---------------------------------------------------------------- tunnel (scripts/tunnel.sh)
# Leave both empty for a quick tunnel (random trycloudflare.com URL, no account).
# For a stable URL on your own domain: see README.md, "Your own stable URL".
ETCH_TUNNEL_NAME=
ETCH_TUNNEL_HOSTNAME=
# Frontend the printed link opens (default https://etch.chat).
ETCH_FRONTEND_URL=

# ---------------------------------------------------------------- advanced (defaults are fine)
# ETCH_THINKING=off            "on" turns Nemotron reasoning on (about 8x slower per call)
# ETCH_PRIMARY_TIMEOUT=30      seconds per primary model call
# ETCH_MAX_ITERS=4             repair tries per build
# ETCH_CLASSIFIER=             "1" routes easy prompts to ETCH_SUB_MODEL (needs torch + transformers, ~740 MB model)
# ETCH_TTS_MODEL / ETCH_TTS_VOICE   OpenAI speech model and voice (gpt-4o-mini-tts-2025-12-15 / cedar)
# ETCH_ALLOW_GPL=              "1" lets the picker use GPL-licensed library parts
# ETCH_KICAD_CLI / ETCH_KICAD_PY / ETCH_KICAD_SHARE   KiCad paths on Linux (the Docker image sets them)
# Every setting with its default: agent/config.py, deploy/etch_public.py, docs/DEPLOY.md
